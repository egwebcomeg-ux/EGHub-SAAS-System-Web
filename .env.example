APP_NAME=EgMenu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo
# First entry is the main domain: landing at <domain>, public menus at <slug>.<domain>,
# dashboard at app.<domain>, super admin at admin.<domain>. Locally *.localhost resolves to 127.0.0.1.
CENTRAL_DOMAINS=localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Backups (egmenu:backup, daily 02:30). BACKUP_DISK=s3 also copies to the S3-compatible bucket (AWS_* keys, plus AWS_ENDPOINT for Backblaze)
BACKUP_KEEP_DAYS=7
BACKUP_DISK=

# WhatsApp to guests (order updates, campaigns). log = nothing is sent (dev); meta = WhatsApp Business Cloud API; webhook = other provider
WHATSAPP_DRIVER=log
# meta: phone number id and a permanent system-user token from Meta Business (never commit real values)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# webhook: JSON POST {to, template, params, locale, text} with header X-EgMenu-Secret
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
# approved template names (defaults: egmenu_order_received, egmenu_order_ready, egmenu_order_on_way, egmenu_reservation_confirmed, egmenu_loyalty_reward, egmenu_campaign)
# WHATSAPP_TPL_ORDER_READY=egmenu_order_ready

# Phone confirmation at signup: owners send "EGMENU <code>" from their mobile to this number (wa.me link, international digits
# e.g. 201012345678). Empty = falls back to the admin setting "support WhatsApp"; with neither set the step is not offered.
WHATSAPP_NUMBER=
# Inbound webhook https://<domain>/webhooks/whatsapp (Meta -> WhatsApp -> Configuration). Any string you choose as verify token;
# the app secret is Meta App -> Settings -> Basic -> App secret and signs every POST. Without it every Meta payload is refused (403).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Website assistant ("Ask us" on the landing pages): answers from the live plans/modules with Claude and hands over to
# the sales WhatsApp. EgWeb's own Anthropic key; empty = the button opens WhatsApp directly. Model defaults to claude-sonnet-5-5.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
# Which model answers: anthropic (ANTHROPIC_API_KEY + ASSISTANT_MODEL) or gemini (GEMINI_API_KEY + ASSISTANT_GEMINI_MODEL)
ASSISTANT_PROVIDER=anthropic
GEMINI_API_KEY=
ASSISTANT_GEMINI_MODEL=gemini-3.6-flash
ASSISTANT_GEMINI_FALLBACK=gemini-3.5-flash

# "Continue with Google / Facebook" for restaurant owners and staff (dashboard login + egmenu.app/register).
# A button shows only when both keys of its provider are set. Authorized redirect URI in the provider console:
# https://app.<CENTRAL_DOMAINS>/auth/google/callback and .../auth/facebook/callback (override with *_REDIRECT_URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Kashier: restaurants pay their EgMenu invoices online (card, wallets, bank installments, valU / Souhoola / Aman ...).
# From the Kashier merchant dashboard: MID, the Payment API key (Integrations) and the secret key. KASHIER_MODE: test | live.
# Switch it on and pick the methods in the super admin (Payment settings). Webhook: https://app.<CENTRAL_DOMAINS>/billing/kashier/webhook
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MODE=test

# The guest's loyalty card in Apple Wallet / Google Wallet. A button shows on the card page only when its keys are set.
# Apple (developer.apple.com > Identifiers > Pass Type IDs): Pass Type ID, Team ID, the pass certificate (.p12 + password,
# or a PEM with certificate and key) and Apple's WWDR intermediate certificate (PEM). Keep the files outside public/.
WALLET_APPLE_PASS_TYPE_ID=
WALLET_APPLE_TEAM_ID=
WALLET_APPLE_CERT_PATH=
WALLET_APPLE_CERT_PASSWORD=
WALLET_APPLE_WWDR_CERT_PATH=
# Google (pay.google.com/business/console): the issuer ID and the JSON key file of a service account allowed on it.
WALLET_GOOGLE_ISSUER_ID=
WALLET_GOOGLE_SERVICE_ACCOUNT_PATH=

# Push notifications to the EgHub Android apps (restaurant, waiter): Firebase Cloud Messaging HTTP v1. The project ID
# and the path of a service-account JSON key (Firebase console → Project settings → Service accounts), kept outside
# public/. Empty = no pushes (logged once a day).
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# Platform admin (admin.<domain>): every admin must turn on two-factor authentication before using the panel
# (false only on a local machine), and an idle admin session is signed out after this many minutes.
ADMIN_REQUIRE_2FA=true
ADMIN_IDLE_MINUTES=120
